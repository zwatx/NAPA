+/* Relabel existing runs without diagonal links. Used only to split oversized
+ * components after the ordinary pass has retained thin, diagonally sampled borders. */
+static void split_diagonal_runs(napa_detector *det, int n) {
+    napa_run *R = det->runs;
+    int32_t *P = det->parent;
+    for (int i = 0; i < n; i++) P[i] = i;
+    int prev_start = 0, prev_end = 0;
+    for (int start = 0; start < n;) {
+        int end = start + 1;
+        while (end < n && R[end].y == R[start].y) end++;
+        if (prev_end > prev_start && R[prev_start].y == R[start].y - 1) {
+            int a = prev_start, b = start;
+            while (a < prev_end && b < end) {
+                if (R[a].x1 < R[b].x0) a++;
+                else if (R[b].x1 < R[a].x0) b++;
+                else {
+                    int32_t ra = find_root(P, a), rb = find_root(P, b);
+                    if (ra < rb) P[rb] = ra;
+                    else if (rb < ra) P[ra] = rb;
+                    if (R[a].x1 < R[b].x1) a++;
+                    else b++;
+                }
+            }
+        }
+        prev_start = start, prev_end = end;
+        start = end;
+    }
+}
